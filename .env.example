# Anthropic API key used for classification and doc generation.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use.
LLM_MODEL=claude-sonnet-4-5

# Secret used to validate incoming GitHub webhook payloads (server mode only).
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Personal access token used to read diffs and open doc-update PRs (server mode only).
GITHUB_TOKEN=ghp_...

# Port the webhook server listens on.
SERVER_PORT=8080

# Path to the code-to-doc mapping config.
DOCPULSE_MAPPING_FILE=docpulse.yaml

# When "true", matching docs are classified and logged but never written or PR'd.
DOCPULSE_DRY_RUN=false
